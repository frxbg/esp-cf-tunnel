--- a/components/esp-tls/esp_tls.c
+++ b/components/esp-tls/esp_tls.c
@@ -508,11 +508,6 @@
             ESP_LOGD(TAG, "non-tls connection established");
             return 1;
         }
-        if (cfg && cfg->non_block) {
-            FD_ZERO(&tls->rset);
-            FD_SET(tls->sockfd, &tls->rset);
-            tls->wset = tls->rset;
-        }
         tls->conn_state = ESP_TLS_CONNECTING;
     /* falls through */
     case ESP_TLS_CONNECTING:
@@ -521,24 +516,46 @@
             struct timeval tv;
             ms_to_timeval(cfg->timeout_ms, &tv);
 
-            /* In case of non-blocking I/O, we use the select() API to check whether
-               connection has been established or not*/
-            if (select(tls->sockfd + 1, &tls->rset, &tls->wset, NULL,
-                       cfg->timeout_ms>0 ? &tv : NULL) == 0) {
-                ESP_LOGD(TAG, "select() timed out");
+            /* select() mutates its fd_sets, including on timeout. Rebuild them
+             * on EVERY asynchronous poll, not only in ESP_TLS_INIT. */
+            FD_ZERO(&tls->rset);
+            FD_SET(tls->sockfd, &tls->rset);
+            tls->wset = tls->rset;
+            int ready = select(tls->sockfd + 1, &tls->rset, &tls->wset, NULL,
+                               cfg->timeout_ms > 0 ? &tv : NULL);
+            if (ready < 0) {
+                int saved_errno = errno;
+                if (saved_errno == EINTR || saved_errno == EAGAIN || saved_errno == EWOULDBLOCK) {
+                    return 0;
+                }
+                ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_SYSTEM, saved_errno);
+                ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_ESP, ESP_ERR_ESP_TLS_FAILED_CONNECT_TO_HOST);
+                tls->conn_state = ESP_TLS_FAIL;
+                return -1;
+            }
+            if (ready == 0 || (!FD_ISSET(tls->sockfd, &tls->rset) && !FD_ISSET(tls->sockfd, &tls->wset))) {
                 return 0;
             }
-            if (FD_ISSET(tls->sockfd, &tls->rset) || FD_ISSET(tls->sockfd, &tls->wset)) {
-                int error;
-                socklen_t len = sizeof(error);
-                /* pending error check */
-                if (getsockopt(tls->sockfd, SOL_SOCKET, SO_ERROR, &error, &len) < 0) {
-                    ESP_LOGD(TAG, "Non blocking connect failed");
-                    ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_SYSTEM, errno);
-                    ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_ESP, ESP_ERR_ESP_TLS_SOCKET_SETOPT_FAILED);
-                    tls->conn_state = ESP_TLS_FAIL;
-                    return -1;
+            int error = 0;
+            socklen_t len = sizeof(error);
+            if (getsockopt(tls->sockfd, SOL_SOCKET, SO_ERROR, &error, &len) < 0) {
+                int saved_errno = errno;
+                if (saved_errno == EINTR) {
+                    return 0;
                 }
+                ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_SYSTEM, saved_errno);
+                ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_ESP, ESP_ERR_ESP_TLS_SOCKET_SETOPT_FAILED);
+                tls->conn_state = ESP_TLS_FAIL;
+                return -1;
+            }
+            if (error == EINPROGRESS || error == EALREADY || error == EWOULDBLOCK) {
+                return 0;
+            }
+            if (error != 0) {
+                ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_SYSTEM, error);
+                ESP_INT_EVENT_TRACKER_CAPTURE(tls->error_handle, ESP_TLS_ERR_TYPE_ESP, ESP_ERR_ESP_TLS_FAILED_CONNECT_TO_HOST);
+                tls->conn_state = ESP_TLS_FAIL;
+                return -1;
             }
         }
         /* By now, the connection has been established */
